<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.intranet_adm.controller.CentralAvisosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Central de Avisos" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Título:" />
        <TextField fx:id="tituloField" promptText="Digite o título" HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Autor:" />
        <TextField fx:id="autorField" promptText="Digite o autor" HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox spacing="5.0">
        <Label text="Mensagem:" />
        <TextArea fx:id="mensagemField" promptText="Digite a mensagem" wrapText="true" prefRowCount="5" />
    </VBox>

    <HBox spacing="10.0">
        <Button fx:id="publicarButton" text="Publicar Aviso" onAction="#onPublicarClick" styleClass="send-button" />
        <Label fx:id="statusLabel" styleClass="muted" />
    </HBox>

    <Label text="Histórico de Avisos" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <ListView fx:id="avisosListView" prefHeight="200" />
</VBox>