<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.intranet_adm.HelloController"
            styleClass="root-pane">

    <top>
        <VBox styleClass="header">
            <children>
                <Label text="Mural de Avisos" styleClass="header-title"/>
                <Label text="Intranet ADM" styleClass="header-subtitle"/>
            </children>
        </VBox>
    </top>

    <left>
        <VBox styleClass="form-panel" spacing="10" prefWidth="280">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <Label text="Novo aviso" styleClass="section-title"/>

                <Label text="Título" styleClass="field-label"/>
                <TextField fx:id="tituloField" promptText="Ex: Manutenção programada"/>

                <Label text="Autor / Setor" styleClass="field-label"/>
                <TextField fx:id="autorField" promptText="Ex: TI, RH..."/>

                <Label text="Mensagem" styleClass="field-label"/>
                <TextArea fx:id="mensagemField" promptText="Escreva o aviso..." wrapText="true" prefRowCount="6"/>

                <Button text="Publicar" styleClass="btn-primary" maxWidth="Infinity" onAction="#onPublicarClick"/>
                <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox styleClass="list-panel" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <Label text="Avisos publicados" styleClass="section-title"/>
                <ListView fx:id="avisosListView" VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
    </center>

</BorderPane>
